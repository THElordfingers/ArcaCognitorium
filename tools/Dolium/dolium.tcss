/* ═══════════════════════════════════════════════════════════════════════════
   The Dolium — dolium.tcss
   Full Arca Cognitorium palette. Same DNA, distinct structure.
   ═══════════════════════════════════════════════════════════════════════════ */


/* ── Base ─────────────────────────────────────────────────────────────────── */

Screen {
    background: #0D0B0E;
    color: #D4C8A8;
    layout: vertical;
}


/* ── Three-pane layout ───────────────────────────────────────────────────── */

#main-layout {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
}

#pipeline {
    width: 25%;
    min-width: 24;
    background: #161218;
    border-right: solid #C9A84C;
    overflow-y: auto;
}

#workspace {
    width: 45%;
    background: #161218;
    border-right: solid #2A2535;
    overflow-y: auto;
    padding: 0 1;
}

#conversation {
    width: 30%;
    background: #0D0B0E;
    layout: vertical;
}


/* ── Header bar ──────────────────────────────────────────────────────────── */

#app-header {
    height: 1;
    background: #1A1628;
    border-bottom: solid #C9A84C;
    padding: 0 2;
    color: #C9A84C;
    text-style: bold;
    content-align: left middle;
}


/* ── Status bar ──────────────────────────────────────────────────────────── */

#status-bar {
    height: 1;
    background: #0D0B0E;
    border-top: solid #2A2535;
    padding: 0 2;
    color: #5A6070;
    content-align: left middle;
}


/* ── Pipeline Nav ────────────────────────────────────────────────────────── */

.chamber-header {
    height: auto;
    padding: 0 1;
    text-style: bold;
    background: #1A1628;
    border-bottom: solid #2A2535;
    color: #C9A84C;
}

.chamber-header-1 { color: #A98FD4 !important; border-left: wide #A98FD4; }
.chamber-header-2 { color: #7EC8C8 !important; border-left: wide #7EC8C8; }
.chamber-header-3 { color: #C87941 !important; border-left: wide #C87941; }
.chamber-header-4 { color: #E8C96A !important; border-left: wide #E8C96A; }

.idea-entry {
    height: auto;
    padding: 0 2;
    color: #D4C8A8;
    background: #161218;
}

.idea-entry:hover {
    background: #1A1628;
    color: #C9A84C;
}

.idea-entry.active {
    background: #1A1628;
    border-left: wide #C9A84C;
    color: #E8C96A;
    text-style: bold;
}

.idea-entry-1 { border-left: solid #2A1A4A; }
.idea-entry-2 { border-left: solid #1A2A2A; }
.idea-entry-3 { border-left: solid #2A1A0A; }
.idea-entry-4 { border-left: solid #2A2200; }

.chamber-empty {
    color: #2A2535;
    padding: 0 2;
    height: auto;
    text-style: italic;
}

.pipeline-search {
    margin: 1 1 0 1;
    background: #0D0B0E;
    border: solid #2A2535;
    color: #D4C8A8;
    height: 3;
}

.pipeline-search:focus {
    border: solid #C9A84C;
}


/* ── Workspace ───────────────────────────────────────────────────────────── */

.field-label {
    color: #5A6070;
    text-style: italic;
    height: auto;
    padding: 1 0 0 0;
}

.field-label.required {
    color: #C9A84C;
}

.chamber-badge {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    text-style: bold;
}

.chamber-badge-1 { color: #A98FD4; background: #1A1040; }
.chamber-badge-2 { color: #7EC8C8; background: #0A1A1A; }
.chamber-badge-3 { color: #C87941; background: #1A0E04; }
.chamber-badge-4 { color: #E8C96A; background: #1A1400; }

Input {
    background: #1A1628;
    border: solid #2A2535;
    color: #D4C8A8;
    height: 3;
    margin: 0 0 0 0;
}

Input:focus {
    border: solid #C9A84C;
    color: #E8C96A;
}

TextArea {
    background: #131020;
    border: solid #2A2535;
    color: #D4C8A8;
    height: 8;
    margin: 0 0 1 0;
}

TextArea:focus {
    border: solid #C9A84C;
}

.workspace-title {
    color: #C9A84C;
    text-style: bold;
    height: auto;
    padding: 1 0 0 0;
}


/* ── Gate status bar ─────────────────────────────────────────────────────── */

.gate-bar-container {
    height: auto;
    background: #1A1628;
    border-top: solid #2A2535;
    padding: 1 1;
    layout: horizontal;
}

.gate-status {
    width: 1fr;
    height: auto;
    color: #5A6070;
    content-align: left middle;
}

.gate-passed  { color: #4A9A6A; }
.gate-partial { color: #C87941; }
.gate-blocked { color: #9A3A3A; }

.btn-advance {
    margin: 0 1 0 0;
    background: #1A2A1A;
    border: solid #4A9A6A;
    color: #4A9A6A;
    min-width: 12;
}

.btn-advance:hover {
    background: #2A3A2A;
    color: #6ABA8A;
}

.btn-advance:disabled {
    background: #1A1628;
    border: solid #2A2535;
    color: #2A2535;
}

.btn-return {
    background: #1A1020;
    border: solid #2A2535;
    color: #5A6070;
    min-width: 10;
}

.btn-return:hover {
    border: solid #A98FD4;
    color: #A98FD4;
}

.btn-cull {
    background: #1A0A0A;
    border: solid #2A2535;
    color: #5A6070;
    min-width: 8;
}

.btn-cull:hover {
    border: solid #9A3A3A;
    color: #9A3A3A;
}


/* ── Conversation pane ───────────────────────────────────────────────────── */

#conv-header {
    height: 1;
    background: #1A1628;
    border-bottom: solid #2A2535;
    padding: 0 1;
    color: #5A6070;
    content-align: left middle;
    text-style: italic;
}

#conv-history {
    height: 1fr;
    overflow-y: auto;
    padding: 0 1;
    background: #0D0B0E;
}

.conv-bubble-user {
    height: auto;
    margin: 1 0 0 2;
    padding: 0 1;
    background: #0F1318;
    border: solid #2A3A4A;
    border-left: wide #4A7A9B;
    color: #D4C8A8;
}

.conv-bubble-assistant {
    height: auto;
    margin: 0 2 1 0;
    padding: 0 1;
    background: #131020;
    border: solid #2A2535;
    border-left: wide #C9A84C;
    color: #D4C8A8;
}

.conv-label-user {
    color: #4A7A9B;
    text-style: bold;
    height: auto;
}

.conv-label-assistant {
    color: #C9A84C;
    text-style: bold;
    height: auto;
}

.conv-empty {
    color: #2A2535;
    text-style: italic;
    padding: 2 1;
    height: auto;
}

#conv-input-row {
    height: auto;
    border-top: solid #2A2535;
    padding: 1 1 0 1;
    background: #0D0B0E;
    layout: horizontal;
}

#conv-input {
    width: 1fr;
    background: #1A1628;
    border: solid #2A2535;
    color: #D4C8A8;
    height: 3;
}

#conv-input:focus {
    border: solid #C9A84C;
}

#conv-send {
    margin: 0 0 0 1;
    background: #1A1628;
    border: solid #C9A84C;
    color: #C9A84C;
    min-width: 8;
    height: 3;
}

#conv-send:hover {
    background: #2A2535;
    color: #E8C96A;
}


/* ── Modals ──────────────────────────────────────────────────────────────── */

.modal-overlay {
    align: center middle;
    background: #0D0B0E 80%;
}

.modal-container {
    width: 60%;
    max-width: 80;
    height: auto;
    max-height: 80%;
    background: #161218;
    border: solid #C9A84C;
    padding: 1 2;
}

.modal-title {
    color: #C9A84C;
    text-style: bold;
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid #2A2535;
    margin-bottom: 1;
}

.modal-body {
    height: auto;
    color: #D4C8A8;
    margin: 0 0 1 0;
}

.gate-failure {
    color: #9A3A3A;
    height: auto;
    padding: 0 0 0 1;
}

.gate-success {
    color: #4A9A6A;
    height: auto;
    padding: 0 0 0 1;
}

.modal-buttons {
    layout: horizontal;
    height: auto;
    padding: 1 0 0 0;
    border-top: solid #2A2535;
    margin-top: 1;
    align: right middle;
}

.btn-confirm {
    background: #1A2A1A;
    border: solid #4A9A6A;
    color: #4A9A6A;
    margin: 0 0 0 1;
}

.btn-confirm:hover {
    background: #2A3A2A;
    color: #6ABA8A;
}

.btn-cancel {
    background: #1A1628;
    border: solid #2A2535;
    color: #5A6070;
    margin: 0 0 0 1;
}

.btn-cancel:hover {
    border: solid #5A6070;
    color: #D4C8A8;
}

.btn-danger {
    background: #1A0A0A;
    border: solid #9A3A3A;
    color: #9A3A3A;
    margin: 0 0 0 1;
}

.btn-danger:hover {
    background: #2A1010;
    color: #CA5A5A;
}

.cull-record {
    height: auto;
    padding: 1;
    margin: 0 0 1 0;
    background: #0F0D1A;
    border: solid #2A2535;
    border-left: wide #9A3A3A;
}

.cull-record-title {
    color: #D4C8A8;
    text-style: bold;
    height: auto;
}

.cull-record-meta {
    color: #5A6070;
    text-style: italic;
    height: auto;
}

.cull-record-epitaph {
    color: #8C7B5C;
    height: auto;
    padding: 0 0 0 1;
}

/* ── Pipeline title & hints ──────────────────────────────────────────────── */

#pipeline-title {
    height: 3;
    background: #1A1628;
    border-bottom: solid #C9A84C;
    padding: 1 2;
    color: #C9A84C;
    text-style: bold;
    content-align: left middle;
}

#pipeline-hint {
    height: 1;
    background: #0D0B0E;
    padding: 0 2;
    color: #5A6070;
    content-align: left middle;
}

.pipeline-new-cta {
    height: auto;
    padding: 0 2;
    color: #C9A84C;
    text-style: bold;
    background: #0D0B0E;
}

/* ── System bubbles (slash command responses) ────────────────────────────── */

.conv-bubble-system {
    height: auto;
    margin: 0 4 1 4;
    padding: 0 1;
    color: #5A6070;
    text-style: italic;
    border-left: wide #2A2535;
    background: #0D0B0E;
}

/* ── System / command response bubbles ───────────────────────────────────── */

.conv-bubble-system {
    height: auto;
    margin: 0 4 1 4;
    padding: 0 1;
    background: #0D0B0E;
    border: solid #2A2535;
    border-left: wide #5A6070;
    color: #5A6070;
    text-style: italic;
}

/* ── Attach indicator ────────────────────────────────────────────────────── */

#attach-indicator {
    height: 1;
    background: #1A1A0A;
    border-top: solid #C87941;
    padding: 0 1;
    color: #C87941;
    content-align: left middle;
}

/* ── Outer border ────────────────────────────────────────────────────────── */

Screen {
    border: solid #C9A84C;
}

/* ── Command button bar ──────────────────────────────────────────────────── */

#conv-cmd-bar {
    height: auto;
    background: #0D0B0E;
    border-top: solid #1A1628;
    padding: 0 1;
    layout: horizontal;
}

.cmd-btn {
    background: #0D0B0E;
    border: solid #2A2535;
    color: #5A6070;
    min-width: 10;
    height: 3;
    margin: 0;
}

.cmd-btn:hover {
    border: solid #C9A84C;
    color: #C9A84C;
    background: #1A1628;
}

/* ── Manpage overlay ─────────────────────────────────────────────────────── */

#manpage-container {
    width: 80%;
    max-width: 100;
    height: 85%;
    background: #161218;
    border: solid #C9A84C;
    padding: 1 2;
}

#manpage-tabs {
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid #2A2535;
    margin-bottom: 1;
    layout: horizontal;
}

.manpage-tab {
    background: #0D0B0E;
    border: solid #2A2535;
    color: #5A6070;
    height: 3;
    margin: 0 1 0 0;
}

.manpage-tab:hover {
    border: solid #C9A84C;
    color: #C9A84C;
}

.manpage-tab-active {
    background: #1A1628;
    border: solid #C9A84C;
    color: #E8C96A;
    text-style: bold;
}

#manpage-scroll {
    height: 1fr;
    overflow-y: auto;
}

.manpage-body {
    color: #D4C8A8;
    height: auto;
    padding: 0 1;
}
