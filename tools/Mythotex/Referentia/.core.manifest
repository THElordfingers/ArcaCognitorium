2. Expanding the Categories (The Workshop Roster)

Based on luminarious_vII_the_living_tower.docx, I have expanded the buttons to include the "Emergent" workshops. Here is the final roster for this iteration:

    The Forge: Wands, Staves, Relics.

    The Bindery: Tomes, Grimoires, Ancient Scrolls.

    The Alchemical Lab: Potions, Philtres, Raw Reagents.

    The Weaver’s Loom: Robes, Cowls, Charms.

    The Menagerie: Beasts, Homunculi, Entities.

    The Conservatory: Mystical Plants, Fungi, Essences.

    The Printing House: Broadsheets, Formal Declarations, Sigils.

3. The "Solid" Logic: JSON Sidecars & Error Handling

We will add a RelicManager class. When you click "Keep," it does three things:

    Saves asset_TIMESTAMP.png.

    Saves asset_TIMESTAMP.json (containing the Lore text, Seed, CFG Scale, and Category).

    Moves the "Temporary" file to a permanent /vault/relics folder.

The Final Prototype Code (v1.4)

This is the complete, developer-ready script. Note: Since it uses 12 threads and loads a heavy model, ensure no other heavy applications are running on your KDE desktop during the first launch.
Python

import sys, os, torch, datetime, json, openai
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QSplashScreen, QSlider)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QPropertyAnimation, QEasingCurve
from PyQt6.QtGui import QPixmap
from diffusers import StableDiffusionPipeline, EulerDiscreteScheduler

# --- SYSTEM TUNING ---
THREADS = 12
torch.set_num_threads(THREADS)
os.environ["OMP_NUM_THREADS"] = str(THREADS)
MODEL_ID = "runwayml/stable-diffusion-v1-5"
VAULT_DIR = os.path.expanduser("~/Arca_Vault/Atelier")
os.makedirs(VAULT_DIR, exist_ok=True)

# --- THE LORE ARCHITECTURE ---
MASTER_STYLE = "Masterpiece alchemical illustration, centered on parchment, esoteric ink style: "
NEGATIVE = "modern, photo, human, blurry, text, watermark, low quality, vibrant colors"

class RitualWorker(QThread):
    finished = pyqtSignal(dict) # Returns a dictionary of all results
    status_update = pyqtSignal(str)

    def __init__(self, category, pipe, settings):
        super().__init__()
        self.category = category
        self.pipe = pipe
        self.settings = settings

    def run(self):
        self.status_update.emit(f"Consulting the Arca regarding {self.category}...")
        
        # 1. ORACLE (OpenAI) - Deeply Engrained Lore
        try:
            client = openai.OpenAI() 
            res = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {"role": "system", "content": "You are the Assessor of the Arca Cognitorium. Describe a single magical object. Use scholarly, mysterious language. Include materials and a specific 'Aura Signature'. Max 50 words."},
                    {"role": "user", "content": f"A unique {self.category}."}
                ]
            )
            lore = res.choices[0].message.content
        except: lore = "A standard manifestation. The Oracle is preoccupied."

        # 2. THE FORGE (SD 1.5)
        self.status_update.emit("Forging visual essence (CPU Threads Active)...")
        seed = self.settings['seed'] if self.settings['seed'] != -1 else torch.seed()
        generator = torch.Generator("cpu").manual_seed(seed)
        
        image = self.pipe(
            prompt=MASTER_STYLE + lore,
            negative_prompt=NEGATIVE,
            num_inference_steps=self.settings['steps'],
            guidance_scale=self.settings['cfg'],
            generator=generator
        ).images[0]
        
        temp_path = "temp_relic.png"
        image.save(temp_path)
        
        self.finished.emit({
            "image_path": temp_path,
            "lore": lore,
            "seed": seed,
            "category": self.category
        })

class Atelier(QMainWindow):
    def __init__(self, pipe):
        super().__init__()
        self.pipe = pipe
        self.latest_data = {}
        self.setWindowTitle("ARCA COGNITORIUM // THE ATELIER SATELLITE")
        self.setMinimumSize(1200, 800)
        self.setStyleSheet(self.get_wizard_styles())
        self.init_ui()

    def get_wizard_styles(self):
        return """
            QMainWindow { background-color: #050507; }
            QFrame#Sidebar { background-color: #0a0a0f; border-right: 1px solid #d4af37; }
            QLabel { color: #d4af37; font-family: 'Constantia', serif; }
            QTextEdit { background-color: #000; color: #a0a0a0; border: 1px solid #1a1a1a; font-size: 14px; }
            QPushButton { background-color: #12121a; color: #d4af37; border: 1px solid #3d3d4d; padding: 12px; font-weight: bold; }
            QPushButton:hover { border-color: #ffffff; }
            QStatusBar { color: #888; background: #0a0a0f; }
        """

    def init_ui(self):
        layout = QHBoxLayout()
        container = QWidget()
        container.setLayout(layout)
        self.setCentralWidget(container)

        # Sidebar with lore-accurate categories
        side_frame = QFrame()
        side_frame.setObjectName("Sidebar")
        side_layout = QVBoxLayout(side_frame)
        
        categories = ["Wands", "Tomes", "Potions", "Clothing", "Beasts", "Plants", "Relics"]
        for cat in categories:
            btn = QPushButton(f"✦ {cat.upper()}")
            btn.clicked.connect(lambda ch, c=cat: self.start_ritual(c))
            side_layout.addWidget(btn)
        
        side_layout.addStretch()
        layout.addWidget(side_frame, 1)

        # Center Viewport
        view_layout = QVBoxLayout()
        self.img_display = QLabel("The Forge is Cold. Select a category.")
        self.img_display.setFixedSize(512, 512)
        self.img_display.setStyleSheet("border: 1px solid #222; background: #000;")
        self.img_display.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        self.text_display = QTextEdit()
        self.text_display.setReadOnly(True)
        
        self.keep_btn = QPushButton("SEAL IN VAULT")
        self.keep_btn.clicked.connect(self.save_relic)
        self.keep_btn.hide()

        view_layout.addWidget(self.img_display, alignment=Qt.AlignmentFlag.AlignCenter)
        view_layout.addWidget(self.text_display)
        view_layout.addWidget(self.keep_btn)
        layout.addLayout(view_layout, 4)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def start_ritual(self, category):
        self.keep_btn.hide()
        # Default settings for v1.4
        settings = {'steps': 25, 'cfg': 8.0, 'seed': -1}
        self.worker = RitualWorker(category, self.pipe, settings)
        self.worker.status_update.connect(lambda m: self.status.showMessage(m))
        self.worker.finished.connect(self.on_ritual_finished)
        self.worker.start()

    def on_ritual_finished(self, data):
        self.latest_data = data
        self.img_display.setPixmap(QPixmap(data['image_path']))
        self.text_display.setText(data['lore'])
        self.keep_btn.show()
        self.status.showMessage("Ritual complete. Asset manifested.")

    def save_relic(self):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        base_name = f"relic_{ts}"
        
        # Save PNG
        os.rename(self.latest_data['image_path'], f"{VAULT_DIR}/{base_name}.png")
        
        # Save JSON Metadata (Deep Lore Tracking)
        with open(f"{VAULT_DIR}/{base_name}.json", "w") as f:
            json.dump({
                "category": self.latest_data['category'],
                "lore": self.latest_data['lore'],
                "seed": self.latest_data['seed'],
                "timestamp": ts,
                "engine": "Atelier Satellite v1.4"
            }, f, indent=4)
            
        self.status.showMessage(f"Relic secured in Vault: {base_name}")
        self.keep_btn.hide()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    splash = QSplashScreen(QPixmap(600, 400)) # Placeholder splash
    splash.show()
    splash.showMessage("Awakening the Arca Cognitorium...", Qt.AlignmentFlag.AlignBottom, Qt.GlobalColor.white)
    
    # Model Initialization (From your gen.py)
    pipe = StableDiffusionPipeline.from_pretrained(MODEL_ID, torch_dtype=torch.float32).to("cpu")
    pipe.enable_attention_slicing()
    pipe.vae.enable_slicing()
    
    window = Atelier(pipe)
    splash.finish(window)
    window.show()
    sys.exit(app.exec())

