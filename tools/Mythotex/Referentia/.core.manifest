MODEL_ID = "runwayml/stable-diffusion-v1-5"
VAULT_DIR = "vault"
os.makedirs(VAULT_DIR, exist_ok=True)

# --- WIZARDRY STYLESHEET (KDE/X11 DARK) ---
WIZARD_THEME = """
    QMainWindow { background-color: #0d0d12; }
    QFrame#Sidebar { background-color: #15151f; border-right: 1px solid #d4af37; }
    QLabel { color: #d4af37; font-family: 'Constantia', serif; font-size: 16px; }
    QTextEdit { 
        background-color: #050508; color: #b0b0b0; 
        border: 1px solid #2a2a3a; font-size: 14px; line-height: 1.5;
    }
    QPushButton {
        background-color: #1a1a24; color: #d4af37;
        border: 1px solid #3d3d4d; border-radius: 4px; padding: 12px;
        font-weight: bold; text-align: left;
    }
    QPushButton:hover { background-color: #252535; border-color: #ffffff; }
    QPushButton#KeepBtn { background-color: #1e3a1e; color: #90ee90; border-color: #90ee90; }
"""

class RitualWorker(QThread):
    finished = pyqtSignal(str, str)
    status_update = pyqtSignal(str)

    def __init__(self, category, pipe):
        super().__init__()
        self.category = category
        self.pipe = pipe

    def run(self):
        self.status_update.emit(f"Reading the Astral Current for {self.category}...")
        
        # 1. ORACLE CALL (OpenAI)
        try:
            client = openai.OpenAI() # Uses OPENAI_API_KEY from env
            res = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {"role": "system", "content": "You are the Assessor. Describe an emergent magical asset. Scholarly, mysterious, brief."},
                    {"role": "user", "content": f"A unique {self.category}."}
                ]
            )
            lore = res.choices[0].message.content
        except: lore = "The stars are occluded. No description could be parsed."

        # 2. THE FORGE (SD 1.5)
        self.status_update.emit("Manifesting visual essence (CPU)...")
        prompt = f"Alchemical illustration, {self.category}, {lore}, parchment background, intricate ink style --v 1.5"
        
        # CPU generation (optimized)
        image = self.pipe(prompt=prompt, num_inference_steps=20).images[0]
        
        path = f"temp_{self.category.lower()}.png"
        image.save(path)
        self.finished.emit(path, lore)

class Atelier(QMainWindow):
    def __init__(self, pipe):
        super().__init__()
        self.pipe = pipe
        self.current_lore = ""
        self.current_img = ""
        
        self.setWindowTitle("ARCA COGNITORIUM // THE ATELIER")
        self.setStyleSheet(WIZARD_THEME)
        self.setMinimumSize(1200, 800)
        self.init_ui()

    def init_ui(self):
        main_layout = QHBoxLayout()
        container = QWidget()
        container.setLayout(main_layout)
        self.setCentralWidget(container)

        # SIDEBAR
        sidebar = QFrame()
        sidebar.setObjectName("Sidebar")
        side_layout = QVBoxLayout(sidebar)
        
        cats = ["Wands", "Tomes", "Potions", "Clothing", "Beasts", "Materials", "Relics"]
        for c in cats:
            btn = QPushButton(f"✦ Generate {c}")
            btn.clicked.connect(lambda ch, cat=c: self.start_ritual(cat))
            side_layout.addWidget(btn)
        
        side_layout.addStretch()
        main_layout.addWidget(sidebar, 1)

        # VIEWPORT
        view_layout = QVBoxLayout()
        self.img_label = QLabel("The Atelier is ready.")
        self.img_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.img_label.setScaledContents(True)
        self.img_label.setFixedSize(512, 512)
        
        self.desc_box = QTextEdit()
        self.desc_box.setReadOnly(True)
        
        self.keep_btn = QPushButton("SEAL IN VAULT")
        self.keep_btn.setObjectName("KeepBtn")
        self.keep_btn.clicked.connect(self.save_to_vault)
        self.keep_btn.hide()

        view_layout.addWidget(self.img_label, alignment=Qt.AlignmentFlag.AlignCenter)
        view_layout.addWidget(self.desc_box)
        view_layout.addWidget(self.keep_btn)
        main_layout.addLayout(view_layout, 4)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def start_ritual(self, category):
        self.worker = RitualWorker(category, self.pipe)
        self.worker.status_update.connect(lambda s: self.status.showMessage(s))
        self.worker.finished.connect(self.display_result)
        self.worker.start()

    def display_result(self, img_path, lore):
        self.current_img = img_path
        self.current_lore = lore
        self.img_label.setPixmap(QPixmap(img_path))
        self.desc_box.setText(lore)
        self.keep_btn.show()
        self.status.showMessage("Ritual Complete.")

    def save_to_vault(self):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        os.rename(self.current_img, f"{VAULT_DIR}/item_{ts}.png")
        with open(f"{VAULT_DIR}/item_{ts}.txt", "w") as f:
            f.write(self.current_lore)
        self.status.showMessage("Asset bound to the Vault.")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    # 3. THE LOADING RITUAL (Splash)
    splash = QSplashScreen(QPixmap(500, 300))
    splash.show()
    splash.showMessage("COMMUNING WITH THE MODEL...", Qt.AlignmentFlag.AlignBottom | Qt.AlignmentFlag.AlignCenter, Qt.GlobalColor.white)
    
    # Load SD Model (Your gen.py logic)
    pipe = StableDiffusionPipeline.from_pretrained(MODEL_ID, torch_dtype=torch.float32).to("cpu")
    pipe.enable_attention_slicing()
    
    window = Atelier(pipe)
    splash.finish(window)
    window.show()
    sys.exit(app.exec())

