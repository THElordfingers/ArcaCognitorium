import sys, os, torch, datetime, json, openai, re
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QSplashScreen, QProgressBar, QSlider)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QPropertyAnimation, QEasingCurve
from PyQt6.QtGui import QPixmap, QFont

# --- SYSTEM & DIRECTORY CONFIG ---
THREADS = 12
torch.set_num_threads(THREADS)
BASE_DIR = "/home/lordfingers/Mythotex"
VAULT_DIR = os.path.join(BASE_DIR, "Vault")
LIB_FILE = os.path.join(BASE_DIR, "library.json")
os.makedirs(VAULT_DIR, exist_ok=True)

MODEL_ID = "runwayml/stable-diffusion-v1-5"

class MythotexWorker(QThread):
    finished = pyqtSignal(dict)
    status_update = pyqtSignal(str)
    progress_val = pyqtSignal(int)

    def __init__(self, category, pipe, is_reforge=False, existing_lore=None, settings=None):
        super().__init__()
        # Grammar fix: strip "The " for status messages
        self.category_clean = category.replace("The ", "")
        self.category_raw = category
        self.pipe = pipe
        self.is_reforge = is_reforge
        self.existing_lore = existing_lore
        self.settings = settings or {'steps': 25, 'cfg': 8.0}

    def run(self):
        # 1. ORACLE CALL (JSON Formatted)
        if not self.is_reforge:
            self.status_update.emit(f"Consulting the Arca regarding {self.category_clean}...")
            try:
                client = openai.OpenAI()
                lib_context = ""
                if os.path.exists(LIB_FILE):
                    with open(LIB_FILE, 'r') as f:
                        lib_context = str(json.load(f))[-500:]

                res = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": "Return JSON: {title, description, history, aura}. Tone: Esoteric. Description: visual focus. History: Mythological snippet."},
                        {"role": "user", "content": f"Manifest a unique {self.category_raw}. Context: {lib_context}"}
                    ],
                    response_format={ "type": "json_object" }
                )
                lore_data = json.loads(res.choices[0].message.content)
            except:
                lore_data = {"title": "Unknown Relic", "description": "Hazy form.", "history": "Lost.", "aura": "None."}
        else:
            lore_data = self.existing_lore

        # 2. THE FORGE (SD 1.5)
        self.status_update.emit(f"Forging {lore_data['title']}...")
        prompt = f"Masterpiece alchemical illustration, {lore_data['title']}, {lore_data['description']}, centered on parchment, esoteric style"
        
        def pipe_callback(step, timestep, latents):
            prog = int((step / self.settings['steps']) * 100)
            self.progress_val.emit(prog)

        # Fix for Scheduler IndexError: Re-seed and ensure clean pipe state
        generator = torch.Generator("cpu").manual_seed(torch.seed())
        
        image = self.pipe(
            prompt=prompt,
            negative_prompt="modern, photo, blurry, text, watermark, human, face",
            num_inference_steps=self.settings['steps'],
            guidance_scale=self.settings['cfg'],
            generator=generator,
            callback=pipe_callback,
            callback_steps=1
        ).images[0]
        
        temp_path = os.path.join(BASE_DIR, "temp_manifest.png")
        image.save(temp_path)
        self.finished.emit({"path": temp_path, "lore": lore_data})

class MythotexApp(QMainWindow):
    def __init__(self, pipe):
        super().__init__()
        self.pipe = pipe
        self.latest_data = None
