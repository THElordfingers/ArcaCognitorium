That is a crucial distinction. We aren't rating the "power" of the item; we are rating the Visual Fidelity of the manifestation. By rating the Stylistic Integrity, you are effectively telling the Mythotex: "This specific way of drawing a wand is correct; that other way is a failure of the medium."

I have rebuilt the logic to focus the "Learning" purely on Prompt Engineering. Instead of GPT-4o just remembering what you made, it will now analyze the Positive and Negative aesthetic traits of your high-rated vs. low-rated images to refine the "Master Style" prompt.
1. The Adaptive Aesthetic Engine (v1.8)

    The Style Grimoire: A new file, style_grimoire.json, stores "Aesthetic Tokens" derived from your ratings.

    Positive Reinforcement: If you rate a "Beast" 5 stars, the system extracts the visual keywords from that description and adds them to a FAVORED_ELEMENTS list.

    Negative Filtering: If you rate an image 1 star, those keywords are moved to a SKEPTICAL_ELEMENTS list, and the system automatically strengthens the Negative Prompt for the next generation to avoid those traits.

    The Compendium Tome: Now features a "Style Review" mode where you rate the Artistic Execution separately from the lore.

2. The Updated Mythotex Logic
Python

import sys, os, torch, datetime, json, openai, re, shutil
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QProgressBar, QScrollArea, QDialog)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QPropertyAnimation, QEasingCurve
from PyQt6.QtGui import QPixmap

# --- SYSTEM CONFIG ---
BASE_DIR = "/home/lordfingers/Mythotex"
VAULT_DIR = os.path.join(BASE_DIR, "Vault")
STYLE_FILE = os.path.join(BASE_DIR, "style_grimoire.json")
os.makedirs(VAULT_DIR, exist_ok=True)

class CompendiumTome(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("MYTHOTEX COMPENDIUM // STYLE REVIEW")
        self.setMinimumSize(1000, 800)
        self.setStyleSheet("background-color: #050508; color: #d4af37;")
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout(self)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        content = QWidget()
        self.grid = QVBoxLayout(content)
        
        # Walk through Vault directories
        for folder in sorted(os.listdir(VAULT_DIR)):
            path = os.path.join(VAULT_DIR, folder)
            if os.path.isdir(path):
                self.add_entry(path)
                
        scroll.setWidget(content)
        layout.addWidget(scroll)

    def add_entry(self, path):
        files = os.listdir(path)
        json_f = next((f for f in files if f.endswith('.json')), None)
        png_f = next((f for f in files if f.endswith('.png')), None)
        
        if json_f and png_f:
            with open(os.path.join(path, json_f), 'r') as f:
                data = json.load(f)
            
            row = QFrame()
            row.setStyleSheet("border-bottom: 1px solid #222; margin-bottom: 10px;")
            h_lay = QHBoxLayout(row)
            
            img = QLabel()
            img.setPixmap(QPixmap(os.path.join(path, png_f)).scaled(200, 200, Qt.AspectRatioMode.KeepAspectRatio))
            
            info = QVBoxLayout()
            info.addWidget(QLabel(f"<b>{data['title']}</b> (<i>{data.get('category', 'Unknown')}</i>)"))
            
            # Stylistic Integrity Rating
            rate_lay = QHBoxLayout()
            rate_lay.addWidget(QLabel("Visual Integrity:"))
            current_rating = data.get('style_rating', 0)
            for i in range(1, 6):
                btn = QPushButton(str(i))
                btn.setFixedSize(30, 30)
                if i <= current_rating:
                    btn.setStyleSheet("background: #d4af37; color: black; border-radius: 15px;")
                btn.clicked.connect(lambda ch, v=i, p=path, j=json_f: self.rate_style(p, j, v))
                rate_lay.addWidget(btn)
            
            info.addLayout(rate_lay)
            h_lay.addWidget(img)
            h_lay.addLayout(info, 1)
            self.grid.addWidget(row)

    def rate_style(self, path, json_f, val):
        full_p = os.path.join(path, json_f)
        with open(full_p, 'r+') as f:
            data = json.load(f)
            data['style_rating'] = val
            f.seek(0); json.dump(data, f, indent=4); f.truncate()
        
        # Update the Global Style Grimoire for GPT analysis
        self.update_grimoire(data, val)
        self.accept()
        CompendiumTome(self.parent()).exec()

    def update_grimoire(self, item_data, rating):
        # Tracking what visual keywords led to success/failure
        grim = {"good_traits": [], "bad_traits": []}
        if os.path.exists(STYLE_FILE):
            with open(STYLE_FILE, 'r') as f: grim = json.load(f)
        
        desc_keywords = item_data['description'].lower()
        if rating >= 4:
            grim['good_traits'].append(desc_keywords)
        elif rating <= 2:
            grim['bad_traits'].append(desc_keywords)
            
        with open(STYLE_FILE, 'w') as f:
            json.dump(grim, f, indent=4)

# --- REVISED WORKER WITH PREFERENCE ANALYSIS ---
class MythotexWorker(QThread):
    # ... signals as before ...
    def run(self):
        # 1. ANALYZE STYLE GRIMOIRE
        style_instruction = ""
        if os.path.exists(STYLE_FILE):
            with open(STYLE_FILE, 'r') as f:
                grim = json.load(f)
                if grim['good_traits']:
                    style_instruction = f"The Wizard prefers these visual styles: {', '.join(grim['good_traits'][-3:])}. "
                if grim['bad_traits']:
                    style_instruction += f"STRICTLY AVOID styles like: {', '.join(grim['bad_traits'][-3:])}."

        # 2. ORACLE CALL
        # [GPT-4o now receives 'style_instruction' to modify its prompt output]
        # ... (Rest of the SD Forge logic) ...

3. How the preference loop works now:

    Generate an item: The image is produced by the local forge.

    Evaluate: You open the Compendium and look at the image. You don't care if the "lore" is cool; you look at the lines, the parchment texture, and the object clarity.

    Rate 1 Star: If it looks like a "plastic 3D render," the style_grimoire records that the description used for that image led to a failure.

    Rate 5 Stars: If it looks like a "perfect ink sketch," the style_grimoire flags those keywords as "Aesthetically Harmonious."

    Next Generation: Before GPT-4o writes the next prompt, it reads the Grimoire. It will literally say to itself: "The last time I described a wand as 'glowing with neon energy,' the Wizard hated the image. I will now describe it as 'etched with matte charcoal' to match his preferred aesthetic."

