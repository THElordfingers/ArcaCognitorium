We have reached the end of Phase 2 (Seed Prompt) and are ready for the Final Assembly. Below is the complete, production-ready logic for the Mythotex Satellite Engine.
The Mythotex: Technical Architecture

    The Oracle (OpenAI): Uses a "Stylistic Anchor" prompt. It knows the vibe of the Arca Cognitorium but is told to be "Inventive and Unpredictable."

    The Forge (Stable Diffusion): Optimized for your 12-thread CPU. I’ve added vae.enable_slicing() and attention_slicing to ensure it runs without crashing your KDE session.

    The Reliquary (Persistence): Every "Keep" action creates a paired .png and .json. This makes your assets "Machine Readable" for the main project later.

Python

import sys, os, torch, datetime, json, openai
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QSplashScreen)
from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtGui import QPixmap, QFont
from diffusers import StableDiffusionPipeline, EulerDiscreteScheduler

# --- SYSTEM TUNING (Debian 13 / 12-Thread CPU) ---
THREADS = 12
torch.set_num_threads(THREADS)
os.environ["OMP_NUM_THREADS"] = str(THREADS)
MODEL_ID = "runwayml/stable-diffusion-v1-5"
VAULT_DIR = os.path.expanduser("~/Mythotex_Vault")
os.makedirs(VAULT_DIR, exist_ok=True)

# --- THE MYTHOTEX STYLE BIBLE ---
# Anchoring the "Wizardry" aesthetic without being restrictive
MASTER_STYLE = "Masterpiece alchemical illustration, centered on antique parchment, esoteric ink and charcoal style, highly detailed, scholarly botanical/mechanical sketch: "
NEGATIVE_STYLE = "photorealistic, modern, plastic, neon, human, face, colorful background, 3d, digital render, text, watermark"

class MythotexWorker(QThread):
    finished = pyqtSignal(dict)
    status_update = pyqtSignal(str)

    def __init__(self, category, pipe):
        super().__init__()
        self.category = category
        self.pipe = pipe

    def run(self):
        self.status_update.emit(f"The Mythotex is weaving a {self.category}...")
        
        # 1. THE ORACLE (Deeply Engrained but Inventive Lore)
        try:
            client = openai.OpenAI() # Pulls from env OPENAI_API_KEY
            res = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {"role": "system", "content": "You are the Assessor of the Arca Cognitorium. Describe a unique, emergent magical item. Use esoteric, scholarly language. Mention unusual materials (metals, woods, essences). End with an 'Aura Signature'. Max 50 words."},
                    {"role": "user", "content": f"Manifest a {self.category}."}
                ]
            )
            lore = res.choices[0].message.content
        except Exception as e:
            lore = f"The Astral link is severed. A mundane {self.category} manifests. (Error: {e})"

        # 2. THE FORGE (Local CPU Generation)
        self.status_update.emit("Forging visual essence (12-Thread CPU)...")
        seed = torch.seed()
        generator = torch.Generator("cpu").manual_seed(seed)
        
        # CPU optimized pipe call
        image = self.pipe(
            prompt=MASTER_STYLE + lore,
            negative_prompt=NEGATIVE_STYLE,
            num_inference_steps=25,
            guidance_scale=8.0,
            generator=generator
        ).images[0]
        
        temp_path = "temp_manifestation.png"
        image.save(temp_path)
        
        self.finished.emit({
            "image_path": temp_path,
            "lore": lore,
            "seed": seed,
            "category": self.category
        })

class MythotexApp(QMainWindow):
    def __init__(self, pipe):
        super().__init__()
        self.pipe = pipe
        self.latest_data = {}
        self.setWindowTitle("MYTHOTEX // THE ATELIER SATELLITE")
        self.setMinimumSize(1100, 800)
        self.setStyleSheet(self.get_styles())
        self.init_ui()

    def get_styles(self):
        return """
            QMainWindow { background-color: #08080a; }
            QFrame#Sidebar { background-color: #0d0d14; border-right: 1px solid #d4af37; }
            QLabel#ImgDisplay { border: 2px solid #1a1a1a; background: #000; border-radius: 5px; }
            QLabel { color: #d4af37; font-family: 'Constantia', serif; }
            QTextEdit { 
                background-color: #050508; color: #c0c0c0; 
                border: 1px solid #2a2a3a; font-family: 'Courier New'; font-size: 13px;
            }
            QPushButton { 
                background-color: #15151f; color: #d4af37; border: 1px solid #3d3d4d; 
                padding: 10px; font-weight: bold; text-align: left;
            }
            QPushButton:hover { border-color: #ffffff; background-color: #1a1a2a; }
            QPushButton#Keep { background-color: #1a2a1a; color: #90ee90; border-color: #4a6a4a; text-align: center; }
        """

    def init_ui(self):
        main_layout = QHBoxLayout()
        container = QWidget()
        container.setLayout(main_layout)
        self.setCentralWidget(container)

        # --- Sidebar ---
        sidebar = QFrame()
        sidebar.setObjectName("Sidebar")
        side_layout = QVBoxLayout(sidebar)
        side_layout.addWidget(QLabel("WORKSHOPS"))
        
        workshops = ["The Forge", "The Bindery", "The Alchemical Lab", "The Weaver's Loom", "The Menagerie", "The Conservatory"]
        for w in workshops:
            btn = QPushButton(f"✦ {w.upper()}")
            btn.clicked.connect(lambda ch, cat=w: self.start_ritual(cat))
            side_layout.addWidget(btn)
        
        side_layout.addStretch()
        main_layout.addWidget(sidebar, 1)

        # --- Viewport ---
        view_layout = QVBoxLayout()
        self.img_label = QLabel("The Mythotex awaits your command.")
        self.img_label.setObjectName("ImgDisplay")
        self.img_label.setFixedSize(512, 512)
        self.img_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        self.desc_box = QTextEdit()
        self.desc_box.setPlaceholderText("Lore will manifest here...")
        
        self.keep_btn = QPushButton("SEAL IN VAULT")
        self.keep_btn.setObjectName("Keep")
        self.keep_btn.hide()
        self.keep_btn.clicked.connect(self.save_to_vault)

        view_layout.addWidget(self.img_label, alignment=Qt.AlignmentFlag.AlignCenter)
        view_layout.addWidget(self.desc_box)
        view_layout.addWidget(self.keep_btn)
        main_layout.addLayout(view_layout, 4)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def start_ritual(self, category):
        self.keep_btn.hide()
        self.worker = MythotexWorker(category, self.pipe)
        self.worker.status_update.connect(lambda m: self.status.showMessage(m))
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def on_finished(self, data):
        self.latest_data = data
        self.img_label.setPixmap(QPixmap(data['image_path']))
        self.desc_box.setText(data['lore'])
        self.keep_btn.show()
        self.status.showMessage("Manifestation Successful.")

    def save_to_vault(self):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"relic_{ts}"
        
        # Save paired data
        os.rename(self.latest_data['image_path'], f"{VAULT_DIR}/{filename}.png")
        with open(f"{VAULT_DIR}/{filename}.json", "w") as f:
            json.dump({
                "category": self.latest_data['category'],
                "lore": self.latest_data['lore'],
                "seed": self.latest_data['seed'],
                "origin": "Mythotex Engine v1.0"
            }, f, indent=4)
            
        self.status.showMessage(f"Bound to Vault: {filename}")
        self.keep_btn.hide()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    # Loading Ritual (Splash)
    splash = QSplashScreen(QPixmap(600, 400)) # Point to a ritual image if you have one
    splash.show()
    splash.setWindowFlags(Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.FramelessWindowHint)
    splash.showMessage("COMMUNING WITH THE LOCAL FORGE...", Qt.AlignmentFlag.AlignBottom, Qt.GlobalColor.white)
    
    # Initializing the Machine (CPU Optimization)
    pipe = StableDiffusionPipeline.from_pretrained(MODEL_ID, torch_dtype=torch.float32).to("cpu")
    pipe.scheduler = EulerDiscreteScheduler.from_config(pipe.scheduler.config)
    pipe.enable_attention_slicing()
    pipe.vae.enable_slicing()
    
    window = MythotexApp(pipe)
    splash.finish(window)
    window.show()
    sys.exit(app.exec())

