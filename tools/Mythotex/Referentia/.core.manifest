        background-color: #1a1a24;
        color: #c0c0c0;
        border: 1px solid #d4af37;
        border-radius: 2px;
        padding: 10px;
    }
    QPushButton:hover { background-color: #2a2a3a; color: #ffffff; }
    QPushButton:pressed { background-color: #d4af37; color: #000000; }
    QProgressBar {
        border: 1px solid #3d3d4d;
        border-radius: 2px;
        text-align: center;
        color: #d4af37;
    }
    QProgressBar::chunk { background-color: #d4af37; }
"""

class RitualWorker(QThread):
    """Background thread for both Lore (OpenAI) and Forge (Stable Diffusion)"""
    finished = pyqtSignal(str, str) # img_path, lore_text
    status_update = pyqtSignal(str)

    def __init__(self, category, pipe):
        super().__init__()
        self.category = category
        self.pipe = pipe

    def run(self):
        # 1. THE ORACLE (OpenAI Lore Generation)
        self.status_update.emit(f"Consulting the Arca Cognitorium for {self.category}...")
        try:
            client = openai.OpenAI()
            response = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {"role": "system", "content": "You are the Assessor of the Arca Cognitorium. Describe a single magical item in a scholarly, esoteric, and mysterious tone. Max 60 words."},
                    {"role": "user", "content": f"Generate a description for an emergent {self.category}."}
                ]
            )
            lore_text = response.choices[0].message.content
        except Exception as e:
            lore_text = f"The Oracle is silent. (Error: {e})"

        # 2. THE FORGE (Stable Diffusion Generation)
        self.status_update.emit("Forging visual essence...")
        
        master_style = "High-quality alchemical illustration, single object centered, white parchment background, esoteric ink and wash style, intricate detail: "
        prompt = master_style + lore_text
        
        generator = torch.Generator("cpu").manual_seed(torch.seed())
        image = self.pipe(
            prompt=prompt,
            num_inference_steps=20,
            guidance_scale=7.5,
            width=512,
            height=512,
            generator=generator
        ).images[0]

        # Save temporary file for display
        temp_path = "temp_gen.png"
        image.save(temp_path)
        
        self.finished.emit(temp_path, lore_text)

class AtelierWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("ARCA COGNITORIUM // THE ATELIER")
        self.setMinimumSize(1100, 800)
        self.setStyleSheet(WIZARD_STYLE)
        
        # Load Model on Startup
        self.pipe = self.initialize_model()
        self.init_ui()

    def initialize_model(self):
        # Integration of your gen.py loading logic
        print("Initializing SD Model on CPU...")
        pipe = StableDiffusionPipeline.from_pretrained(MODEL_ID, torch_dtype=torch.float32)
        pipe.scheduler = EulerDiscreteScheduler.from_config(pipe.scheduler.config)
        pipe = pipe.to("cpu")
        pipe.enable_attention_slicing()
        return pipe

    def init_ui(self):
        # (Layout logic similar to previous, but applying the WIZARD_STYLE)
        # Includes a QProgressBar for 'Ritual Progress'
        pass 

    # Logic for 'Keep' button (Save function)
    def save_to_vault(self):
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        # Save both .png and .txt (Lore) to VAULT_DIR
        pass

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = AtelierWindow()
    window.show()
    sys.exit(app.exec())

