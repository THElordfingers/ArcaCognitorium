WIZARD_STYLE = """
    QMainWindow { background-color: #0a0a0c; }
    QLabel { color: #d4af37; font-family: 'Segoe UI', serif; }
    QTextEdit { 
        background-color: #121216; 
        color: #e0e0e0; 
        border: 1px solid #3d3d4d; 
        border-radius: 4px;
        font-size: 14px;
    }
