import sys, os, torch, datetime, json, openai, re, shutil
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QProgressBar, QSlider, QScrollArea, QDialog)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QPropertyAnimation, QEasingCurve
from PyQt6.QtGui import QPixmap, QColor, QIcon

# --- SYSTEM CONFIG ---
BASE_DIR = "/home/lordfingers/Mythotex"
VAULT_DIR = os.path.join(BASE_DIR, "Vault")
LIB_FILE = os.path.join(BASE_DIR, "library.json")
os.makedirs(VAULT_DIR, exist_ok=True)

class CompendiumTome(QDialog):
    """The 'Tome' popup window to browse saved relics."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("THE MYTHOTEX COMPENDIUM")
        self.setMinimumSize(900, 700)
        self.setStyleSheet("background-color: #0a0a0f; color: #d4af37;")
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout(self)
        
        # Scroll Area for Relics
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("border: none;")
        
        content = QWidget()
        self.grid = QVBoxLayout(content)
        
        # Load entries from Vault
        for folder in sorted(os.listdir(VAULT_DIR)):
            path = os.path.join(VAULT_DIR, folder)
            if os.path.isdir(path):
                self.add_entry_to_tome(path)
                
        scroll.setWidget(content)
        layout.addWidget(scroll)

    def add_entry_to_tome(self, path):
        # Find the latest png/json pair in the folder
        files = os.listdir(path)
        json_file = next((f for f in files if f.endswith('.json')), None)
        png_file = next((f for f in files if f.endswith('.png')), None)
        
        if json_file and png_file:
            with open(os.path.join(path, json_file), 'r') as f:
                data = json.load(f)
            
            row = QFrame()
            row.setStyleSheet("border-bottom: 1px solid #1a1a1a; padding: 10px;")
            h_lay = QHBoxLayout(row)
            
            img = QLabel()
            pix = QPixmap(os.path.join(path, png_file)).scaled(150, 150, Qt.AspectRatioMode.KeepAspectRatio)
            img.setPixmap(pix)
            
            info = QVBoxLayout()
            title = QLabel(f"<b>{data['title']}</b>")
            title.setStyleSheet("font-size: 18px;")
            desc = QLabel(data.get('description', 'No description.'))
            desc.setWordWrap(True)
            
            # Rating Buttons (Resonance)
            rate_lay = QHBoxLayout()
            rate_lay.addWidget(QLabel("Resonance:"))
            current_rating = data.get('resonance', 0)
            for i in range(1, 6):
                star = QPushButton(str(i))
                star.setFixedSize(25, 25)
                if i <= current_rating:
                    star.setStyleSheet("background: #d4af37; color: black;")
                star.clicked.connect(lambda ch, v=i, p=path, j=json_file: self.update_rating(p, j, v))
                rate_lay.addWidget(star)
            rate_lay.addStretch()

            info.addWidget(title)
            info.addWidget(desc)
            info.addLayout(rate_lay)
            
            h_lay.addWidget(img)
            h_lay.addLayout(info, 1)
            self.grid.addWidget(row)

    def update_rating(self, path, json_file, value):
        full_path = os.path.join(path, json_file)
        with open(full_path, 'r') as f:
            data = json.load(f)
        data['resonance'] = value
        with open(full_path, 'w') as f:
            json.dump(data, f, indent=4)
        self.accept() # Close and refresh
        CompendiumTome(self.parent()).exec()

class MythotexApp(QMainWindow):
    # ... [Existing __init__ and UI code from v1.6] ...
    
    # Update to the Start Ritual to include preference analysis
    def start_ritual(self, category):
        self.progress.setValue(0)
        
        # Analyze Preferences
        preferences = []
        for root, dirs, files in os.walk(VAULT_DIR):
            for file in files:
                if file.endswith('.json'):
                    with open(os.path.join(root, file), 'r') as f:
                        d = json.load(f)
                        if d.get('resonance', 0) >= 4:
                            preferences.append(d['description'])
        
        pref_str = " | ".join(preferences[-5:]) # Last 5 highly rated styles
        
        settings = {'steps': self.step_slider.value(), 'cfg': self.cfg_slider.value(), 'prefs': pref_str}
        self.worker = MythotexWorker(category, self.pipe, settings=settings)
        # ... connect signals and start ...

    # Add this to the init_ui Sidebar section:
    # self.comp_btn = QPushButton("📜 OPEN COMPENDIUM")
    # self.comp_btn.clicked.connect(self.show_compendium)
    
    def show_compendium(self):
        tome = CompendiumTome(self)
        tome.exec()

3. Key Features of this Upgrade

    The Rating Loop: The update_rating function modifies the .json of the item. This is "Hard Memory."

    Aesthetic Alignment: In the start_ritual function, the app now searches for files with resonance >= 4. It takes those visual descriptions and passes them to GPT as "Preferred Visual Styles." This forces the Oracle to learn what you like (e.g., if you only rate "Etched Gold" items highly, it will start manifesting more gold).

    The Tome Interface: The popup window is a scrollable list of everything you've saved. It’s built to feel like an index of your vault.

How to use the "Learning" feature:

    Generate a few items.

    Open the Compendium.

    Give 5 stars to the ones that match your vision and 1 star to the ones that don't.

    Generate again—you will notice the text descriptions and images start to gravitate toward the qualities of your 5-star items.

