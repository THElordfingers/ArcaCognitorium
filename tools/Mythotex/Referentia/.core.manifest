import sys, os, torch, datetime, json, openai, re, shutil
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QProgressBar, QSlider, QScrollArea)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QPropertyAnimation, QEasingCurve
from PyQt6.QtGui import QPixmap, QColor
from diffusers import StableDiffusionPipeline, EulerDiscreteScheduler

# --- SYSTEM & DIRECTORY CONFIG ---
THREADS = 12
torch.set_num_threads(THREADS)
BASE_DIR = "/home/lordfingers/Mythotex"
VAULT_DIR = os.path.join(BASE_DIR, "Vault")
LIB_FILE = os.path.join(BASE_DIR, "library.json")
os.makedirs(VAULT_DIR, exist_ok=True)

MODEL_ID = "runwayml/stable-diffusion-v1-5"

class MythotexWorker(QThread):
    finished = pyqtSignal(dict)
    status_update = pyqtSignal(str)
    progress_val = pyqtSignal(int)

    def __init__(self, category, pipe, is_reforge=False, existing_lore=None, settings=None):
        super().__init__()
        self.category = category.replace("The ", "")
        self.pipe = pipe
        self.is_reforge = is_reforge
        self.existing_lore = existing_lore
        self.settings = settings or {'steps': 25, 'cfg': 8.5}

    def run(self):
        # 1. ORACLE CALL: Optimized for deep lore and historical context
        if not self.is_reforge:
            self.status_update.emit(f"Consulting the Arca regarding {self.category}...")
            try:
                # Load library context to feed back into the prompt
                lib_ctx = ""
                if os.path.exists(LIB_FILE):
                    with open(LIB_FILE, 'r') as f:
                        lib_ctx = str(json.load(f))[-600:]

                client = openai.OpenAI()
                res = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": "You are the Assessor. Return ONLY a JSON object with keys: 'title', 'description', 'history', 'aura'. Description: visual specifics for an illustrator. History: 2-3 sentences of deep mythology. Aura: A 2-word esoteric signature."},
                        {"role": "user", "content": f"Manifest a {self.category}. World Context: {lib_ctx}"}
                    ],
                    response_format={ "type": "json_object" }
                )
                lore_data = json.loads(res.choices[0].message.content)
            except Exception as e:
                lore_data = {"title": "Fractured Relic", "description": "A hazy, shifting form.", "history": "This item exists between states of being.", "aura": "Unstable/Void"}
        else:
            lore_data = self.existing_lore

        # 2. THE FORGE: Stable Diffusion with CPU Triage
        self.status_update.emit(f"Forging {lore_data['title']}...")
        
        # Resetting scheduler to prevent the Index 26 out of bounds error
        self.pipe.scheduler = EulerDiscreteScheduler.from_config(self.pipe.scheduler.config)
        
        prompt = f"Masterpiece alchemical illustration, {lore_data['title']}, {lore_data['description']}, centered on aged parchment, intricate ink and wash, esoteric scholarly style, 8k"
        negative = "modern, photographic, 3d render, human, face, blurry, text, watermark, colorful, plastic"
        
        def pipe_callback(step, timestep, latents):
            prog = int((step / self.settings['steps']) * 100)
            self.progress_val.emit(prog)

        generator = torch.Generator("cpu").manual_seed(torch.seed())
        
        image = self.pipe(
            prompt=prompt,
            negative_prompt=negative,
            num_inference_steps=self.settings['steps'],
            guidance_scale=self.settings['cfg'],
            generator=generator,
            callback=pipe_callback,
            callback_steps=1
        ).images[0]
        
        temp_path = os.path.join(BASE_DIR, "temp_render.png")
        image.save(temp_path)
        self.finished.emit({"path": temp_path, "lore": lore_data})

class MythotexApp(QMainWindow):
    def __init__(self, pipe):
        super().__init__()
        self.pipe = pipe
        self.latest_data = None
        self.setWindowTitle("MYTHOTEX // THE ATELIER SATELLITE")
        self.setMinimumSize(1200, 850)
        self.setStyleSheet(self.get_styles())
        self.init_ui()

    def get_styles(self):
        return """
            QMainWindow { background-color: #050507; }
            QFrame#Sidebar { background-color: #0a0a0f; border-right: 1px solid #d4af37; }
            QFrame#ControlPanel { background-color: #0a0a0f; border-left: 1px solid #d4af37; }
            QLabel { color: #d4af37; font-family: 'Constantia', serif; }
            QTextEdit { background-color: #000; color: #a0a0a0; border: 1px solid #1a1a1a; font-size: 14px; }
            QPushButton { background-color: #12121a; color: #d4af37; border: 1px solid #3d3d4d; padding: 12px; font-weight: bold; }
            QPushButton:hover { border-color: #ffffff; background-color: #1a1a24; }
            QProgressBar { border: 1px solid #d4af37; background: #000; text-align: center; color: #d4af37; height: 14px; font-size: 10px; }
            QProgressBar::chunk { background-color: #d4af37; }
            QSlider::handle:horizontal { background: #d4af37; width: 10px; }
        """

    def init_ui(self):
        layout = QHBoxLayout()
        container = QWidget()
        container.setLayout(layout)
        self.setCentralWidget(container)

        # Sidebar
        self.sidebar = QFrame()
        self.sidebar.setObjectName("Sidebar")
        side_lay = QVBoxLayout(self.sidebar)
        side_lay.addWidget(QLabel("WORKSHOPS"))
        
        cats = ["The Forge", "The Bindery", "The Alchemical Lab", "The Weaver's Loom", "The Menagerie", "The Conservatory"]
        for c in cats:
            btn = QPushButton(f"✦ {c.upper()}")
            btn.clicked.connect(lambda ch, cat=c: self.start_ritual(cat))
            side_lay.addWidget(btn)
        
        side_lay.addStretch()
        self.tweak_btn = QPushButton("⚙ RITUAL PARAMETERS")
        self.tweak_btn.clicked.connect(self.toggle_controls)
        side_lay.addWidget(self.tweak_btn)

        # Viewport (Main Area)
        view_lay = QVBoxLayout()
        self.img_label = QLabel("The Forge is Cold.")
        self.img_label.setFixedSize(512, 512)
        self.img_label.setStyleSheet("border: 1px solid #d4af37; background: #000;")
        self.img_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        self.progress = QProgressBar()
        
        self.text_display = QTextEdit()
        self.text_display.setReadOnly(True)
        
        btn_lay = QHBoxLayout()
        self.keep_btn = QPushButton("SEAL IN VAULT")
        self.keep_btn.clicked.connect(self.save_relic)
        self.reforge_btn = QPushButton("REFORGE VISUAL")
        self.reforge_btn.clicked.connect(self.reforge)
        self.keep_btn.hide(); self.reforge_btn.hide()
        
        btn_lay.addWidget(self.keep_btn); btn_lay.addWidget(self.reforge_btn)

        view_lay.addWidget(self.img_label, alignment=Qt.AlignmentFlag.AlignCenter)
        view_lay.addWidget(self.progress)
        view_lay.addWidget(self.text_display)
        view_lay.addLayout(btn_lay)

        # Control Panel (Slide-out)
        self.controls = QFrame()
        self.controls.setObjectName("ControlPanel")
        self.controls.setFixedWidth(0)
        con_lay = QVBoxLayout(self.controls)
        con_lay.addWidget(QLabel("STRENGTH OF RITUAL"))
        
        self.step_slider = self.add_slider(con_lay, "Steps", 10, 50, 25)
        self.cfg_slider = self.add_slider(con_lay, "Guidance", 1, 15, 8)
        con_lay.addStretch()

        layout.addWidget(self.sidebar, 1)
        layout.addLayout(view_lay, 4)
        layout.addWidget(self.controls)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def add_slider(self, layout, name, min_v, max_v, def_v):
        lbl = QLabel(f"{name}: {def_v}")
        sld = QSlider(Qt.Orientation.Horizontal)
        sld.setRange(min_v, max_v)
        sld.setValue(def_v)
        sld.valueChanged.connect(lambda v: lbl.setText(f"{name}: {v}"))
        layout.addWidget(lbl); layout.addWidget(sld)
        return sld

    def toggle_controls(self):
        width = 200 if self.controls.width() == 0 else 0
        self.anim = QPropertyAnimation(self.controls, b"minimumWidth")
        self.anim.setDuration(300)
        self.anim.setEndValue(width)
        self.anim.setEasingCurve(QEasingCurve.Type.InOutQuad)
        self.anim.start()
        self.controls.setMaximumWidth(width)

    def start_ritual(self, category):
        self.progress.setValue(0)
        settings = {'steps': self.step_slider.value(), 'cfg': self.cfg_slider.value()}
        self.worker = MythotexWorker(category, self.pipe, settings=settings)
        self.worker.status_update.connect(self.status.showMessage)
        self.worker.progress_val.connect(self.progress.setValue)
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def reforge(self):
        self.progress.setValue(0)
        settings = {'steps': self.step_slider.value(), 'cfg': self.cfg_slider.value()}
        self.worker = MythotexWorker(self.latest_data['lore']['title'], self.pipe, is_reforge=True, existing_lore=self.latest_data['lore'], settings=settings)
        self.worker.status_update.connect(self.status.showMessage)
        self.worker.progress_val.connect(self.progress.setValue)
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def on_finished(self, data):
        self.latest_data = data
        self.img_label.setPixmap(QPixmap(data['path']))
        l = data['lore']
        html = f"<center><h1 style='color:#d4af37; margin-bottom:0;'>{l['title']}</h1>"
        html += f"<p style='color:#d4af37; margin-top:0;'><i>{l['description']}</i></p><br>"
        html += f"<div style='text-align:justify; margin: 0 40px; line-height:1.6;'>{l['history']}</div><br>"
        html += f"<p style='color:#777; font-weight:bold;'>Aura Signature: {l['aura']}</p></center>"
        self.text_display.setHtml(html)
        self.keep_btn.show(); self.reforge_btn.show()

    def save_relic(self):
        title_slug = re.sub(r'[^\w\s-]', '', self.latest_data['lore']['title']).strip().replace(' ', '_')
        entry_dir = os.path.join(VAULT_DIR, title_slug)
        os.makedirs(entry_dir, exist_ok=True)
        
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        # Save PNG and JSON pair
        shutil.move(self.latest_data['path'], os.path.join(entry_dir, f"relic_{ts}.png"))
        with open(os.path.join(entry_dir, f"relic_{ts}.json"), "w") as f:
            json.dump(self.latest_data['lore'], f, indent=4)
        
        # Update Library context
        lib_data = []
        if os.path.exists(LIB_FILE):
            with open(LIB_FILE, 'r') as f: lib_data = json.load(f)
        lib_data.append({"title": self.latest_data['lore']['title'], "aura": self.latest_data['lore']['aura']})
        with open(LIB_FILE, 'w') as f: json.dump(lib_data[-100:], f)
            
        self.status.showMessage(f"Bound to Vault: {entry_dir}")
        self.keep_btn.hide()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    # Splash Screen for Ritual Loading
    splash = QSplashScreen(QPixmap(600, 400))
    splash.show()
    splash.showMessage("COMMUNING WITH THE LOCAL FORGE...", Qt.AlignmentFlag.AlignBottom, Qt.GlobalColor.white)
    
    pipe = StableDiffusionPipeline.from_pretrained(MODEL_ID, torch_dtype=torch.float32).to("cpu")
    pipe.scheduler = EulerDiscreteScheduler.from_config(pipe.scheduler.config)
    pipe.enable_attention_slicing(); pipe.vae.enable_slicing()
    
    window = MythotexApp(pipe)
    splash.finish(window)
    window.show()
    sys.exit(app.exec())

Improvements in v1.6:

    Grammar & Clarity: The status bar now correctly says "Consulting the Arca regarding [Workshop]" and "Forging [Item Name]."

    Slide-out Control Panel: The "⚙ Ritual Parameters" button now toggles the right-hand panel where you can live-adjust the Steps and Guidance Scale (CFG).

    Historical Snippets: GPT-4o is now constrained to include a "History" key in its JSON, which is then formatted into a justified block of text in the UI.

    Resilience: Re-initializing the scheduler in the worker thread specifically prevents the Index Error you saw, which is caused by the scheduler trying to access steps from a previous run.

    Data Bank: The library.json is updated every time you hit "Seal in Vault," allowing the "Assessor" to remember its own creations.

