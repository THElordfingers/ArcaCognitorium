import sys
import os
import threading
from datetime import datetime
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QFileDialog)
from PyQt6.QtCore import Qt, QThread, pyqtSignal

# --- CONFIGURATION & LORE CONSTANTS ---
VAULT_DIR = "vault"
os.makedirs(VAULT_DIR, exist_ok=True)

MASTER_VISUAL_STYLE = "High-quality alchemical illustration, parchment background, esoteric style: "

class GenerationWorker(QThread):
    """The Background Worker: Prevents the UI from freezing during SD/LLM calls."""
    finished = pyqtSignal(str, str)  # image_path, description_text
    progress = pyqtSignal(str)

    def __init__(self, category):
        super().__init__()
        self.category = category

    run(self):
        self.progress.emit(f"Consulting the Oracle for a {self.category}...")
        
        # 1. TODO: Call OpenAI API to generate lore description
        description = f"A rare {self.category} found in the depths of the Cognitorium..." 
        
        self.progress.emit(f"Forging the visual representation...")
        
        # 2. TODO: Call Local Stable Diffusion (gen.py logic)
        # For v1, we will return a placeholder
        image_path = "placeholder.png" 
        
        self.finished.emit(image_path, description)

class AtelierWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Arca Cognitorium: Satellite Generation Engine")
        self.setMinimumSize(1000, 700)
        self.init_ui()

    def init_ui(self):
        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        main_layout = QHBoxLayout(central_widget)

        # --- Sidebar: Category Buttons ---
        sidebar = QVBoxLayout()
        categories = ["Wands", "Potions", "Tomes", "Clothing", "Beasts", "Materials"]
        for cat in categories:
            btn = QPushButton(cat)
            btn.setFixedHeight(40)
            btn.clicked.connect(lambda checked, c=cat: self.start_generation(c))
            sidebar.addWidget(btn)
        sidebar.addStretch()
        
        # Settings Button
        self.settings_btn = QPushButton("⚙ Control Panel")
        sidebar.addWidget(self.settings_btn)

        # --- Main Display Area ---
        display_layout = QVBoxLayout()
        
        self.image_display = QLabel("Select a category to begin the ritual...")
        self.image_display.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.image_display.setFrameShape(QFrame.Shape.StyledPanel)
        self.image_display.setStyleSheet("background-color: #1e1e1e; border: 2px solid #333;")
        
        self.text_display = QTextEdit()
        self.text_display.setReadOnly(True)
        self.text_display.setPlaceholderText("Lore description will appear here...")
        self.text_display.setMaximumHeight(200)

        # Action Buttons
        actions = QHBoxLayout()
        self.save_btn = QPushButton("Keep (Move to Vault)")
        self.save_btn.setEnabled(False)
        self.save_btn.clicked.connect(self.save_to_vault)
        actions.addWidget(self.save_btn)

        display_layout.addWidget(self.image_display, stretch=3)
        display_layout.addWidget(self.text_display, stretch=1)
        display_layout.addLayout(actions)

        main_layout.addLayout(sidebar, stretch=1)
        main_layout.addLayout(display_layout, stretch=4)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def start_generation(self, category):
        self.status.showMessage(f"Initiating generation: {category}")
        self.worker = GenerationWorker(category)
        self.worker.progress.connect(lambda m: self.status.showMessage(m))
        self.worker.finished.connect(self.on_generation_complete)
        self.worker.start()

    def on_generation_complete(self, img, desc):
        self.text_display.setText(desc)
        self.status.showMessage("Generation Complete.")
        self.save_btn.setEnabled(True)
        # Update image logic goes here

    def save_to_vault(self):
        # Implementation of moving files to VAULT_DIR with unique timestamps
        self.status.showMessage("Asset secured in the Vault.")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = AtelierWindow()
    window.show()
    sys.exit(app.exec())

