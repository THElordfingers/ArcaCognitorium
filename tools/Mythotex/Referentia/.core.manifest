Python

import sys
import os
import torch
import datetime
import openai
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QLabel, QTextEdit, 
                             QFrame, QStatusBar, QProgressBar, QSplashScreen,
                             QSlider, QGroupBox, QFormLayout)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QPropertyAnimation, QEasingCurve
from PyQt6.QtGui import QPixmap, QFont
from diffusers import StableDiffusionPipeline, EulerDiscreteScheduler

# --- SYSTEM & CPU TUNING (From gen.py) ---
THREADS = 12
torch.set_num_threads(THREADS)
os.environ["OMP_NUM_THREADS"] = str(THREADS)
MODEL_ID = "runwayml/stable-diffusion-v1-5"
VAULT_DIR = "vault"
os.makedirs(VAULT_DIR, exist_ok=True)

# --- THE ESOTERIC STYLE GUIDE ---
MASTER_PROMPT = "High-quality alchemical illustration, single object centered, white parchment background, esoteric ink and wash style, intricate detail, 8k, scholarly aesthetic: "
NEGATIVE_PROMPT = "modern, 3d render, plastic, blurry, text, watermark, messy, photographic, human, face, colorful background, borders, frames"

WIZARD_THEME = """
    QMainWindow { background-color: #08080a; }
    QFrame#Sidebar { background-color: #0f0f15; border-right: 1px solid #d4af37; }
    QFrame#ControlPanel { background-color: #15151f; border-left: 1px solid #d4af37; }
    QLabel { color: #d4af37; font-family: 'Constantia', serif; }
    QTextEdit { 
        background-color: #050508; color: #b0b0b0; 
        border: 1px solid #2a2a3a; font-family: 'Courier New';
    }
    QPushButton {
        background-color: #1a1a24; color: #d4af37;
        border: 1px solid #3d3d4d; border-radius: 2px; padding: 10px;
        font-variant: small-caps;
    }
    QPushButton:hover { border-color: #ffffff; background-color: #222230; }
    QSlider::handle:horizontal { background: #d4af37; border-radius: 5px; }
"""

class RitualWorker(QThread):
    finished = pyqtSignal(str, str)
    status_update = pyqtSignal(str)

    def __init__(self, category, pipe, settings):
        super().__init__()
        self.category = category
        self.pipe = pipe
        self.settings = settings # Dict of Steps, CFG, Seed

    def run(self):
        self.status_update.emit(f"Consulting the Arca for a {self.category}...")
        
        # 1. ORACLE (OpenAI)
        try:
            client = openai.OpenAI() 
            res = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {"role": "system", "content": "You are the Assessor of the Arca Cognitorium. Describe a single magical asset in a scholarly, esoteric tone. Focus on materials and aura. Max 50 words."},
                    {"role": "user", "content": f"Describe a unique {self.category}."}
                ]
            )
            lore = res.choices[0].message.content
        except: lore = "The void is silent. A standard specimen manifests."

        # 2. THE FORGE (SD 1.5)
        self.status_update.emit("Manifesting visual essence (CPU)...")
        full_prompt = MASTER_PROMPT + lore
        
        seed = self.settings['seed'] if self.settings['seed'] != -1 else torch.seed()
        generator = torch.Generator("cpu").manual_seed(seed)
        
        image = self.pipe(
            prompt=full_prompt,
            negative_prompt=NEGATIVE_PROMPT,
            num_inference_steps=self.settings['steps'],
            guidance_scale=self.settings['cfg'],
            generator=generator
        ).images[0]
        
        path = f"temp_render.png"
        image.save(path)
        self.finished.emit(path, lore)

class Atelier(QMainWindow):
    def __init__(self, pipe):
        super().__init__()
        self.pipe = pipe
        self.setWindowTitle("ARCA COGNITORIUM // THE ATELIER")
        self.setStyleSheet(WIZARD_THEME)
        self.setMinimumSize(1200, 800)
        self.init_ui()

    def init_ui(self):
        main_layout = QHBoxLayout()
        container = QWidget()
        container.setLayout(main_layout)
        self.setCentralWidget(container)

        # --- SIDEBAR (Categories) ---
        self.sidebar = QFrame()
        self.sidebar.setObjectName("Sidebar")
        side_lay = QVBoxLayout(self.sidebar)
        cats = ["Wands", "Tomes", "Potions", "Clothing", "Beasts", "Relics", "Materials"]
        for c in cats:
            btn = QPushButton(f"✦ {c}")
            btn.clicked.connect(lambda ch, cat=c: self.start_ritual(cat))
            side_lay.addWidget(btn)
        side_lay.addStretch()
        self.toggle_settings = QPushButton("⚙ Tweak Ritual")
        self.toggle_settings.clicked.connect(self.animate_settings)
        side_lay.addWidget(self.toggle_settings)

        # --- VIEWPORT (Center) ---
        view_lay = QVBoxLayout()
        self.img_label = QLabel("Awaiting the Spark of Creation...")
        self.img_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.img_label.setFixedSize(512, 512)
        self.img_label.setStyleSheet("border: 1px solid #d4af37; background: #000;")
        
        self.desc_box = QTextEdit()
        self.keep_btn = QPushButton("SEAL IN VAULT")
        self.keep_btn.clicked.connect(self.save_to_vault)
        self.keep_btn.hide()

        view_lay.addWidget(self.img_label, alignment=Qt.AlignmentFlag.AlignCenter)
        view_lay.addWidget(self.desc_box)
        view_lay.addWidget(self.keep_btn)

        # --- CONTROL PANEL (Slide-out) ---
        self.controls = QFrame()
        self.controls.setObjectName("ControlPanel")
        self.controls.setFixedWidth(0) # Initially hidden
        con_lay = QVBoxLayout(self.controls)
        con_lay.addWidget(QLabel("RITUAL PARAMETERS"))
        
        self.step_slider = self.add_setting(con_lay, "Inference Steps", 1, 50, 20)
        self.cfg_slider = self.add_setting(con_lay, "Guidance Scale", 1, 20, 7)
        
        main_layout.addWidget(self.sidebar, 1)
        main_layout.addLayout(view_lay, 4)
        main_layout.addWidget(self.controls)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def add_setting(self, layout, name, min_v, max_v, def_v):
        label = QLabel(f"{name}: {def_v}")
        slider = QSlider(Qt.Orientation.Horizontal)
        slider.setRange(min_v, max_v)
        slider.setValue(def_v)
        slider.valueChanged.connect(lambda v: label.setText(f"{name}: {v}"))
        layout.addWidget(label)
        layout.addWidget(slider)
        return slider

    def animate_settings(self):
        target = 250 if self.controls.width() == 0 else 0
        self.anim = QPropertyAnimation(self.controls, b"minimumWidth")
        self.anim.setDuration(300)
        self.anim.setEndValue(target)
        self.anim.setEasingCurve(QEasingCurve.Type.InOutQuart)
        self.anim.start()
        self.controls.setMaximumWidth(target)

    def start_ritual(self, category):
        settings = {'steps': self.step_slider.value(), 'cfg': self.cfg_slider.value(), 'seed': -1}
        self.worker = RitualWorker(category, self.pipe, settings)
        self.worker.status_update.connect(lambda s: self.status.showMessage(s))
        self.worker.finished.connect(self.display_result)
        self.worker.start()

    def display_result(self, img, lore):
        self.img_label.setPixmap(QPixmap(img))
        self.desc_box.setText(lore)
        self.keep_btn.show()

    def save_to_vault(self):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        os.rename("temp_render.png", f"{VAULT_DIR}/asset_{ts}.png")
        self.status.showMessage(f"Bound to {VAULT_DIR}/asset_{ts}.png")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    splash = QSplashScreen(QPixmap(600, 400)) # You can point this to a real image
    splash.show()
    splash.showMessage("Awakening the Local Forge (CPU)...", Qt.AlignmentFlag.AlignCenter | Qt.AlignmentFlag.AlignBottom, Qt.GlobalColor.white)
    
    # Model Load
    pipe = StableDiffusionPipeline.from_pretrained(MODEL_ID, torch_dtype=torch.float32).to("cpu")
    pipe.enable_attention_slicing()
    
    window = Atelier(pipe)
    splash.finish(window)
    window.show()
    sys.exit(app.exec())

