QWidget {
    background-color: #050300;
    color: #7c8660;
    font-family: "IM Fell English", "Georgia", serif;
    font-size: 12px;
    border: none;
    outline: none;
}

QMainWindow {
    background-color: #050300;
}

QPushButton {
    background-color: #050300;
    color: #4f6000;
    border: 1px solid #131c00;
    font-family: "Share Tech Mono", "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 1.5px;
    padding: 5px 12px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #131c00;
    color: #4dea8a;
    border-color: #4f6000;
}

QPushButton:pressed {
    background-color: #4f6000;
    color: #050300;
}

QLabel {
    background: transparent;
    color: #7c8660;
}

QLineEdit {
    background-color: #050300;
    color: #7c8660;
    border: 1px solid #131c00;
    font-family: "Share Tech Mono", monospace;
    font-size: 10px;
    padding: 4px 8px;
    selection-background-color: #131c00;
    selection-color: #4dea8a;
}

QLineEdit:focus {
    border-color: #4f6000;
}

QComboBox {
    background-color: #050300;
    color: #4dea8a;
    border: 1px solid #131c00;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background: #050300;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #131c00;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #4f6000;
}

QTabBar::tab {
    background-color: transparent;
    color: #4f6000;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    letter-spacing: 2px;
    padding: 7px 16px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #4dea8a;
    border-bottom: 2px solid #4dea8a;
    background-color: rgba(212, 175, 55, 0.04);
}

QTableWidget, QTableView {
    background-color: #050300;
    color: #7c8660;
    border: 1px solid #131c00;
    gridline-color: #131c00;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
}

QHeaderView::section {
    background-color: #141108;
    color: #4dea8a;
    border: 1px solid #131c00;
    font-family: "Share Tech Mono", monospace;
    font-size: 8px;
    padding: 4px 8px;
    font-weight: normal;
}

QToolTip {
    background-color: #141108;
    color: #7c8660;
    border: 1px solid #131c00;
    font-family: "Share Tech Mono", monospace;
    font-size: 10px;
    padding: 4px 8px;
}
