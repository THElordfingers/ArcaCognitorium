/*
  AUCTORITAS SPECTRALIS — v1.0.0
  base.qss — ModusArcanus base stylesheet
  All colours from the canonical token set.
*/

/* ── Palette variables (approximated via named values) ─────────────── */
/* --void:       #050507  */
/* --obsidian:   #0a0a12  */
/* --gold:       #d4af37  */
/* --gold-dim:   #7a6a2a  */
/* --gold-dark:  #3a2e10  */
/* --crimson:    #8b1a1a  */
/* --teal:       #1a5a5a  */
/* --parchment:  #c8b88a  */
/* --vellum:     #e8e0cc  */

/* ── Global ──────────────────────────────────────────────────────────── */

QWidget {
    background-color: #050507;
    color: #c8b88a;
    font-family: "IM Fell English", "Georgia", serif;
    font-size: 12px;
    border: none;
    outline: none;
}

QMainWindow {
    background-color: #050507;
}

/* ── Scroll bars ─────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: #050507;
    width: 8px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #3a2e10;
    min-height: 20px;
    border: none;
}
QScrollBar::handle:vertical:hover {
    background: #7a6a2a;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #050507;
    height: 8px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #3a2e10;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background: #7a6a2a;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Tooltips ────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #0a0a12;
    color: #c8b88a;
    border: 1px solid #3a2e10;
    font-family: "Share Tech Mono", "Courier New", monospace;
    font-size: 10px;
    padding: 4px 8px;
}

/* ── Menus / Context menus ───────────────────────────────────────────── */

QMenu {
    background-color: #0a0a12;
    color: #c8b88a;
    border: 1px solid #3a2e10;
    font-size: 11px;
}
QMenu::item:selected {
    background-color: #3a2e10;
    color: #d4af37;
}
QMenu::separator {
    height: 1px;
    background: #3a2e10;
    margin: 3px 0;
}

/* ── ComboBox ────────────────────────────────────────────────────────── */

QComboBox {
    background-color: #050507;
    color: #d4af37;
    border: 1px solid #3a2e10;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    letter-spacing: 1px;
    padding: 4px 8px;
    min-width: 120px;
}
QComboBox:hover {
    border-color: #7a6a2a;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    width: 6px;
    height: 6px;
    border-left: 1px solid #7a6a2a;
    border-bottom: 1px solid #7a6a2a;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #0a0a12;
    color: #c8b88a;
    border: 1px solid #3a2e10;
    selection-background-color: #3a2e10;
    selection-color: #d4af37;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
}

/* ── Line Edit ───────────────────────────────────────────────────────── */

QLineEdit {
    background-color: #050507;
    color: #c8b88a;
    border: 1px solid #3a2e10;
    font-family: "Share Tech Mono", monospace;
    font-size: 10px;
    padding: 4px 8px;
    selection-background-color: #3a2e10;
    selection-color: #d4af37;
}
QLineEdit:focus {
    border-color: #7a6a2a;
}

/* ── Push Button ─────────────────────────────────────────────────────── */

QPushButton {
    background-color: #050507;
    color: #7a6a2a;
    border: 1px solid #3a2e10;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 5px 12px;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #3a2e10;
    color: #d4af37;
    border-color: #7a6a2a;
}
QPushButton:pressed {
    background-color: #7a6a2a;
    color: #050507;
}
QPushButton:disabled {
    color: #3a2e10;
    border-color: #1a1608;
}

/* Primary button variant */
QPushButton[class="primary"] {
    color: #d4af37;
    border-color: #7a6a2a;
}
QPushButton[class="primary"]:hover {
    background-color: #3a2e10;
}

/* Confirm (teal) button variant */
QPushButton[class="confirm"] {
    color: #1a5a5a;
    border-color: #1a5a5a;
}
QPushButton[class="confirm"]:hover {
    background-color: rgba(26, 90, 90, 0.15);
    color: #a0d0c0;
    border-color: #a0d0c0;
}

/* Danger (crimson) button variant */
QPushButton[class="danger"] {
    color: #8b1a1a;
    border-color: #8b1a1a;
}
QPushButton[class="danger"]:hover {
    background-color: rgba(139, 26, 26, 0.15);
    color: #e08080;
}

/* Warning state for GENERATE button */
QPushButton[class="generate-warn"] {
    color: #c8b88a;
    border-color: #7a6a2a;
    border-width: 1px;
}

/* ── Table ───────────────────────────────────────────────────────────── */

QTableWidget, QTableView {
    background-color: #050507;
    color: #c8b88a;
    border: 1px solid #3a2e10;
    gridline-color: #3a2e10;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    selection-background-color: rgba(212, 175, 55, 0.08);
    selection-color: #d4af37;
    alternate-background-color: rgba(10, 10, 18, 0.5);
}
QTableWidget::item, QTableView::item {
    padding: 4px 8px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: rgba(212, 175, 55, 0.08);
    color: #d4af37;
}
QHeaderView::section {
    background-color: #0a0a12;
    color: #d4af37;
    border: 1px solid #3a2e10;
    font-family: "Share Tech Mono", monospace;
    font-size: 8px;
    letter-spacing: 1px;
    padding: 4px 8px;
    font-weight: normal;
    text-transform: uppercase;
}
QHeaderView::section:hover {
    background-color: #3a2e10;
}

/* ── Splitter ────────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #3a2e10;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ── Tab Bar ─────────────────────────────────────────────────────────── */

QTabBar {
    background-color: #050507;
    border-bottom: 1px solid #3a2e10;
}
QTabBar::tab {
    background-color: transparent;
    color: #7a6a2a;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 7px 16px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
}
QTabBar::tab:selected {
    color: #d4af37;
    border-bottom: 2px solid #d4af37;
    background-color: rgba(212, 175, 55, 0.04);
}
QTabBar::tab:hover:!selected {
    color: #c8b88a;
    background-color: rgba(212, 175, 55, 0.02);
}
QTabWidget::pane {
    border: none;
    border-top: 1px solid #3a2e10;
    margin-top: -1px;
}

/* ── Label ───────────────────────────────────────────────────────────── */

QLabel {
    background: transparent;
    color: #c8b88a;
}

/* ── Frame / Group ───────────────────────────────────────────────────── */

QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #3a2e10;
}

/* ── Checkbox ────────────────────────────────────────────────────────── */

QCheckBox {
    color: #7a6a2a;
    font-family: "Share Tech Mono", monospace;
    font-size: 9px;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #3a2e10;
    background: #050507;
}
QCheckBox::indicator:checked {
    background: #7a6a2a;
    border-color: #d4af37;
}
QCheckBox::indicator:hover {
    border-color: #7a6a2a;
}
